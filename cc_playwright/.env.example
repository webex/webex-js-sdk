# Copy to cc_playwright/.env and fill in. .env is gitignored.
#
# <SET>_<AGENT>_ACCESS_TOKEN / _USERNAME / _EXTENSION_NUMBER / _NAME values are
# generated by global.setup.ts and written back into .env at runtime; do not set them here.

# --- Required: sandbox / agent accounts ---------------------------------------
# Agent usernames are `userNN@${PW_SANDBOX}` (see test-data.ts); all share this password.
PW_SANDBOX=
PW_SANDBOX_PASSWORD=

# --- Required: digital channels ------------------------------------------------
# Base URL of the chat client page; each set appends `-e2e[-N].html`.
PW_CHAT_URL=
# Gmail account + app password used to send email tasks (SET inbound address is
# `${PW_SANDBOX}.e2eN@gmail.com`).
PW_SENDER_EMAIL=
PW_SENDER_EMAIL_PASSWORD=

# --- Required: one inbound telephony entry point (dial number) per set --------
PW_ENTRY_POINT1=
PW_ENTRY_POINT2=
PW_ENTRY_POINT3=
PW_ENTRY_POINT4=
PW_ENTRY_POINT5=
PW_ENTRY_POINT6=
PW_ENTRY_POINT7=
PW_ENTRY_POINT8=
PW_ENTRY_POINT9=

# --- Required: tests fail (not skip) if these are unset -----------------------
# Name of the dial number shown in the consult/transfer destination list (SET_6).
PW_DIAL_NUMBER_NAME=
# Name of the entry point shown in the consult/transfer destination list (SET_4, SET_5).
PW_ENTRYPOINT_NAME=

# --- Optional -----------------------------------------------------------------
# Credentials for the account that answers calls routed to the dial number (SET_6).
PW_DIAL_NUMBER_LOGIN_USERNAME=
PW_DIAL_NUMBER_LOGIN_PASSWORD=
# Fallback extension used by station-login helpers when none is passed explicitly.
PW_EXTENSION_NUMBER=
