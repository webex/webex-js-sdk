# Copy to .env at the repository root -- not next to this file -- and fill in.
# .env is gitignored.
#
# This file drives the Calling SDK Playwright E2E suite, run with
# `yarn workspace @webex/calling run test:e2e`.
#
# USER_<N>_ACCESS_TOKEN / USER_<N>_INT_ACCESS_TOKEN are generated by the OAuth setup
# project (utils/oauth.setup.ts) and written back into .env at runtime.
# Do not set them here.

# --- Runtime configuration ----------------------------------------------------
# Base URL of the locally served sample app. Playwright starts it via `yarn samples:serve`.
PW_BASE_URL=https://localhost:8000
# Browser used by every project: chrome, edge, firefox or safari.
PW_BROWSER=chrome
# Mobius transport. `http` keeps the default; `ws` forces the sample app's WebSocket
# override before SDK initialization. A run covers one transport only.
MOBIUS=http
# `true` reuses the access tokens already in .env and skips the browser OAuth login.
SKIP_AUTH=false
# `true` leaves test voicemails on the account instead of deleting them after the run.
KEEP_TEST_VOICEMAIL=false

# --- Production accounts ------------------------------------------------------
# USER_1..USER_3 run the registration suites, USER_4/USER_5 the call suites,
# USER_6 the contacts suite. See test-data.ts for the
# full account-to-suite mapping. The same account must never be active in two
# browser sessions at once.
USER_1_EMAIL=
USER_1_PASSWORD=
USER_1_PHONE_NUMBER=
USER_2_EMAIL=
USER_2_PASSWORD=
USER_2_PHONE_NUMBER=
USER_3_EMAIL=
USER_3_PASSWORD=
USER_3_PHONE_NUMBER=
USER_4_EMAIL=
USER_4_PASSWORD=
USER_4_PHONE_NUMBER=
USER_5_EMAIL=
USER_5_PASSWORD=
USER_5_PHONE_NUMBER=
USER_6_EMAIL=
USER_6_PASSWORD=
USER_6_PHONE_NUMBER=

# --- Integration accounts -----------------------------------------------------
# Used by the `- INT` Playwright projects. In INT the call accounts are aliases for
# the registration accounts, which is why the INT projects are ordered rather than parallel.
USER_1_INT_EMAIL=
USER_1_INT_PASSWORD=
USER_1_INT_PHONE_NUMBER=
USER_2_INT_EMAIL=
USER_2_INT_PASSWORD=
USER_2_INT_PHONE_NUMBER=
USER_3_INT_EMAIL=
USER_3_INT_PASSWORD=
USER_3_INT_PHONE_NUMBER=
USER_4_INT_EMAIL=
USER_4_INT_PASSWORD=
USER_4_INT_PHONE_NUMBER=
USER_5_INT_EMAIL=
USER_5_INT_PASSWORD=
USER_5_INT_PHONE_NUMBER=
USER_6_INT_EMAIL=
USER_6_INT_PASSWORD=
USER_6_INT_PHONE_NUMBER=
