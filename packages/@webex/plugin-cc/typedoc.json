{
    "name": "Contact Center Plugin",
    "entryPoints": [
        "src/index.ts"
    ],
    "entryPointStrategy": "expand",
    "tsconfig": "tsconfig.json",
    "out": "../../../docs/wxcc",
    "excludePrivate": false,
    "excludeExternals": true,
    "exclude": [
        "**/node_modules/**",
        "**/test/unit/spec/**/*.ts"
    ],
    "hideGenerator": true,
    "theme": "default",
    "cleanOutputDir": true,
    "includeVersion": true,
    "readme": "README.md",
    "disableSources": false,
    "sourceLinkTemplate": "https://github.com/webex/webex-js-sdk/blob/master/{path}#L{line}",
    "validation": {
        "notExported": true,
        "invalidLink": true,
        "notDocumented": true
    },
    "sort": [
        "kind",
        "visibility",
        "alphabetical"
    ],
    "categorizeByGroup": true,
    "categoryOrder": [
        "Core",
        "Services",
        "Classes",
        "Interfaces",
        "Enums",
        "Types",
        "*"
    ],
    "navigationLinks": {
        "Classes": "classes/index.html",
        "Interfaces": "interfaces/index.html",
        "Enums": "enums/index.html",
        "Types": "types/index.html",
        "API Reference": "modules.html",
        "GitHub": "https://github.com/webex/webex-js-sdk"
    },
    "sidebarLinks": {
        "Classes": "classes/index.html",
        "Interfaces": "interfaces/index.html",
        "Types": "types/index.html",
        "Enums": "enums/index.html"
    },
    "searchInComments": true,
    "visibilityFilters": {
        "protected": true,
        "private": false,
        "inherited": true,
        "external": true
    }
}
