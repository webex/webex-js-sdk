{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Webex Contact Center SDK API Reference",
  "version": "1.0.0",
  "namespace": "cc",
  "description": "Contact Center Plugin module that provides functionality for managing contact center agents, handling tasks, and interacting with contact center services.",
  "classes": {
    "ContactCenter": {
      "extends": "WebexPlugin",
      "implements": ["IContactCenter"],
      "description": "The main Contact Center plugin class that enables integration with Webex Contact Center.",
      "namespace": "cc",
      "access": "public",
      "properties": {
        "LoggerProxy": {
          "type": "LoggerProxy",
          "access": "public",
          "description": "Logger utility for Contact Center plugin"
        },
        "addressBook": {
          "type": "AddressBook",
          "access": "public",
          "description": "API instance for managing Webex Contact Center address book contacts"
        }
      },
      "methods": {
        "register": {
          "description": "Initializes the Contact Center SDK by setting up the web socket connections. Must be called before performing any agent operations.",
          "access": "public",
          "params": [],
          "returns": {
            "type": "Promise<Profile>",
            "description": "Agent profile information after successful registration"
          },
          "throws": ["Error if registration fails"],
          "example": "const profile = await cc.register();"
        },
        "deregister": {
          "description": "Unregisters the Contact Center SDK by closing all web socket connections, removing event listeners, and cleaning up internal state. Does NOT perform a station logout.",
          "access": "public",
          "params": [],
          "returns": {
            "type": "Promise<void>",
            "description": "Resolves when deregistration and cleanup are complete"
          },
          "throws": ["Error if deregistration fails"]
        },
        "stationLogin": {
          "description": "Performs agent login with specified credentials and device type.",
          "access": "public",
          "params": [
            {
              "name": "data",
              "type": "AgentLogin",
              "required": true,
              "description": "Login parameters including teamId, loginOption and dialNumber"
            }
          ],
          "returns": {
            "type": "Promise<StationLoginResponse>",
            "description": "Response containing login status and profile"
          },
          "throws": ["Error if login fails"],
          "emits": ["agent:stationLoginSuccess", "agent:stationLoginFailed"]
        },
        "stationLogout": {
          "description": "Performs a station logout operation for the agent. Cannot happen if agent is in an interaction.",
          "access": "public",
          "params": [
            {
              "name": "data",
              "type": "Logout",
              "required": true,
              "description": "Logout parameters with logoutReason"
            }
          ],
          "returns": {
            "type": "Promise<StationLogoutResponse>",
            "description": "Response indicating logout status"
          },
          "throws": ["Error if logout fails"],
          "emits": ["agent:logoutSuccess", "agent:logoutFailed"]
        },
        "setAgentState": {
          "description": "Sets the state of the agent to Available or any of the Idle states.",
          "access": "public",
          "params": [
            {
              "name": "data",
              "type": "StateChange",
              "required": true,
              "description": "State change parameters including the new state"
            }
          ],
          "returns": {
            "type": "Promise<SetStateResponse>",
            "description": "Response with updated state information"
          },
          "throws": ["Error if state change fails"],
          "emits": ["agent:stateChange", "agent:stateChangeSuccess", "agent:stateChangeFailed"]
        },
        "updateAgentProfile": {
          "description": "Updates the agent device type and login configuration (e.g., switching from browser to desk phone).",
          "access": "public",
          "params": [
            {
              "name": "data",
              "type": "AgentProfileUpdate",
              "required": true,
              "description": "Configuration with loginOption, dialNumber, and optional teamId"
            }
          ],
          "returns": {
            "type": "Promise<UpdateDeviceTypeResponse>",
            "description": "Response with device type update confirmation"
          },
          "throws": ["Error if update fails"]
        },
        "startOutdial": {
          "description": "Makes an outbound call to a specified phone number.",
          "access": "public",
          "params": [
            {
              "name": "destination",
              "type": "string",
              "required": true,
              "description": "The phone number to dial (E.164 format)"
            },
            {
              "name": "origin",
              "type": "string",
              "required": true,
              "description": "The contact center number used as caller ID"
            }
          ],
          "returns": {
            "type": "Promise<TaskResponse>",
            "description": "Task response containing interactionId, taskId, and task details"
          },
          "throws": ["Error if outdial fails"],
          "emits": ["task:incoming", "task:established", "task:ended", "task:error"]
        },
        "getBuddyAgents": {
          "description": "Returns the list of buddy agents who are in the given user state and media type.",
          "access": "public",
          "params": [
            {
              "name": "data",
              "type": "BuddyAgents",
              "required": true,
              "description": "Filter options for state and mediaType"
            }
          ],
          "returns": {
            "type": "Promise<BuddyAgentsResponse>",
            "description": "List of available buddy agents"
          },
          "throws": ["Error if fetching fails"]
        },
        "getQueues": {
          "description": "Returns paginated contact service queues for the organization.",
          "access": "public",
          "params": [
            {
              "name": "params",
              "type": "ContactServiceQueueSearchParams",
              "required": false,
              "description": "Search and pagination parameters"
            }
          ],
          "returns": {
            "type": "Promise<ContactServiceQueuesResponse>",
            "description": "Paginated list of queues"
          }
        },
        "getEntryPoints": {
          "description": "Returns paginated entry points for the organization.",
          "access": "public",
          "params": [
            {
              "name": "params",
              "type": "EntryPointSearchParams",
              "required": false,
              "description": "Search and pagination parameters"
            }
          ],
          "returns": {
            "type": "Promise<EntryPointListResponse>",
            "description": "Paginated list of entry points"
          }
        },
        "getOutdialAniEntries": {
          "description": "Fetches outdial ANI (Automatic Number Identification) entries for an outdial ANI ID.",
          "access": "public",
          "params": [
            {
              "name": "params",
              "type": "OutdialAniParams",
              "required": true,
              "description": "ANI query parameters including outdialANI, page, pageSize, search, filter, attributes"
            }
          ],
          "returns": {
            "type": "Promise<OutdialAniEntriesResponse>",
            "description": "List of ANI entries with pagination metadata"
          },
          "throws": ["Error if fetch fails or agent not registered"]
        },
        "uploadLogs": {
          "description": "Uploads logs to help troubleshoot SDK issues.",
          "access": "public",
          "params": [],
          "returns": {
            "type": "Promise<UploadLogsResponse>",
            "description": "Upload response with trackingId and feedbackId"
          },
          "throws": ["Error if upload fails"]
        }
      }
    }
  },
  "types": {
    "AgentLogin": {
      "description": "Request payload for agent login",
      "properties": {
        "dialNumber": { "type": "string", "required": false, "description": "Number to dial (required for AGENT_DN and EXTENSION)" },
        "teamId": { "type": "string", "required": true, "description": "Unique team ID" },
        "loginOption": { "type": "LoginOption", "required": true, "description": "Login method type" }
      }
    },
    "AgentProfileUpdate": {
      "description": "Request payload for updating agent profile",
      "properties": {
        "loginOption": { "type": "LoginOption", "required": true, "description": "New device type" },
        "dialNumber": { "type": "string", "required": false, "description": "Required for EXTENSION or AGENT_DN" },
        "teamId": { "type": "string", "required": false, "description": "Optional team ID" }
      }
    },
    "BuddyAgents": {
      "description": "Options for fetching buddy agents",
      "properties": {
        "mediaType": { "type": "string", "required": true, "enum": ["telephony", "chat", "social", "email"], "description": "Media type channel filter" },
        "state": { "type": "string", "required": false, "enum": ["Available", "Idle"], "description": "Agent state filter" }
      }
    },
    "StateChange": {
      "description": "Parameters for agent state change",
      "properties": {
        "state": { "type": "string", "required": true, "description": "New agent state (Available, Idle)" },
        "auxCodeId": { "type": "string", "required": true, "description": "Auxiliary code ID for the state" },
        "lastStateChangeReason": { "type": "string", "required": false, "description": "Reason for state change" },
        "agentId": { "type": "string", "required": false, "description": "Agent ID (defaults to current agent)" }
      }
    },
    "Logout": {
      "description": "Parameters for agent logout",
      "properties": {
        "logoutReason": { "type": "string", "required": true, "description": "Reason for logging out" }
      }
    },
    "LoginOption": {
      "description": "Supported login options for agent authentication",
      "enum": ["AGENT_DN", "EXTENSION", "BROWSER"]
    },
    "CCPluginConfig": {
      "description": "Configuration options for the Contact Center Plugin",
      "properties": {
        "allowMultiLogin": { "type": "boolean", "description": "Allow multiple logins from different devices" },
        "allowAutomatedRelogin": { "type": "boolean", "description": "Automatically attempt relogin on connection loss" },
        "clientType": { "type": "string", "description": "Type of client making the connection" },
        "isKeepAliveEnabled": { "type": "boolean", "description": "Enable keep-alive messages" },
        "force": { "type": "boolean", "description": "Force registration" },
        "metrics": { "type": "object", "description": "Metrics configuration" },
        "logging": { "type": "object", "description": "Logging configuration" },
        "callingClientConfig": { "type": "CallingClientConfig", "description": "Configuration for the calling client" }
      }
    },
    "Profile": {
      "description": "Agent profile information returned after registration",
      "properties": {
        "agentId": { "type": "string", "description": "Unique identifier for the agent" },
        "defaultDn": { "type": "string", "description": "Default dial number" },
        "teams": { "type": "array", "description": "Array of teams the agent belongs to" },
        "webRtcEnabled": { "type": "boolean", "description": "Indicates if WebRTC is enabled" },
        "loginVoiceOptions": { "type": "array", "description": "Supported login options" },
        "agentProfileID": { "type": "string", "description": "Agent profile ID" },
        "wrapUpData": { "type": "object", "description": "Wrapup configuration data" },
        "outDialEp": { "type": "string", "description": "Outdial entry point ID" },
        "isOutboundEnabledForAgent": { "type": "boolean", "description": "Whether outbound is enabled" }
      }
    },
    "ContactServiceQueue": {
      "description": "Configuration for a contact service queue",
      "properties": {
        "id": { "type": "string", "description": "Unique queue identifier" },
        "name": { "type": "string", "description": "Queue name" },
        "queueType": { "type": "string", "enum": ["INBOUND", "OUTBOUND"], "description": "Queue type" },
        "channelType": { "type": "string", "description": "Channel type (TELEPHONY, EMAIL, CHAT, etc.)" },
        "routingType": { "type": "string", "description": "Routing type" },
        "active": { "type": "boolean", "description": "Whether queue is active" }
      }
    },
    "EntryPointRecord": {
      "description": "Entry point configuration",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "name": { "type": "string", "description": "Entry point name" },
        "type": { "type": "string", "description": "Entry point type" },
        "isActive": { "type": "boolean", "description": "Whether active" }
      }
    },
    "AddressBookEntry": {
      "description": "Address book contact entry",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "name": { "type": "string", "description": "Contact name" },
        "number": { "type": "string", "description": "Contact number" }
      }
    }
  },
  "events": {
    "agent": {
      "agent:stateChange": {
        "description": "Agent's state has changed (Available, Idle, etc.)",
        "data": "StateChangeEvent"
      },
      "agent:stateChangeSuccess": {
        "description": "Agent state change was successful",
        "data": "StateChangeSuccessEvent"
      },
      "agent:stateChangeFailed": {
        "description": "Agent state change failed",
        "data": "StateChangeFailedEvent"
      },
      "agent:stationLoginSuccess": {
        "description": "Agent login was successful",
        "data": "StationLoginSuccessEvent"
      },
      "agent:stationLoginFailed": {
        "description": "Agent login failed",
        "data": "StationLoginFailedEvent"
      },
      "agent:logoutSuccess": {
        "description": "Agent logout was successful",
        "data": "LogoutSuccessEvent"
      },
      "agent:logoutFailed": {
        "description": "Agent logout failed",
        "data": "LogoutFailedEvent"
      },
      "agent:reloginSuccess": {
        "description": "Agent relogin was successful",
        "data": "ReloginSuccessEvent"
      },
      "agent:multiLogin": {
        "description": "Agent has logged in from multiple locations",
        "data": "MultiLoginEvent"
      },
      "agent:dnRegistered": {
        "description": "Agent DN has been registered",
        "data": "DnRegisteredEvent"
      }
    },
    "task": {
      "task:incoming": {
        "description": "New task is being offered",
        "data": "ITask"
      },
      "task:hydrate": {
        "description": "Task data has been updated",
        "data": "ITask"
      },
      "task:merged": {
        "description": "Task has been merged (EPDN merge/transfer)",
        "data": "ITask"
      },
      "task:established": {
        "description": "Task/call has been connected",
        "data": "TaskEstablishedEvent"
      },
      "task:ended": {
        "description": "Task/call has ended",
        "data": "TaskEndedEvent"
      },
      "task:error": {
        "description": "An error occurred during task handling",
        "data": "TaskErrorEvent"
      }
    }
  },
  "services": {
    "agent": {
      "description": "Agent state and lifecycle management",
      "methods": ["reload", "logout", "stationLogin", "stateChange", "buddyAgents"]
    },
    "config": {
      "description": "Agent configuration data fetching",
      "methods": ["getAgentConfig", "getOutdialAniEntries", "getUserDetails", "getDesktopProfile", "getTeams", "getAuxCodes"]
    },
    "task": {
      "description": "Task lifecycle management",
      "components": ["TaskManager", "Task", "AutoWrapup"]
    },
    "core": {
      "description": "Core infrastructure components",
      "components": ["WebSocketManager", "ConnectionService", "WebexRequest", "AqmReqs", "Utils", "Err"]
    },
    "dialer": {
      "description": "Outbound dialing operations",
      "methods": ["startOutdial"]
    },
    "contact": {
      "description": "Contact operations (hold, resume, transfer, etc.)"
    }
  }
}
