{
  "name": "@webex/kms-caroots",
  "description": "Verify the Cisco Trusted Root Store bundle and generate the CA roots used to validate the Webex KMS certificate.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/webex/webex-js-sdk.git",
    "directory": "packages/@webex/kms-caroots"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./index.js",
  "browser": "./verify.js",
  "types": "./index.d.ts",
  "bin": {
    "webex-kms-caroots": "./cli.js"
  },
  "dependencies": {
    "asn1js": "3.0.10",
    "pkijs": "3.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.17.10",
    "@webex/babel-config-legacy": "workspace:*",
    "@webex/jest-config-legacy": "workspace:*",
    "@webex/legacy-tools": "workspace:*",
    "@webex/test-helper-chai": "workspace:*",
    "eslint": "^8.24.0",
    "sinon": "^9.2.4"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "verify.js",
    "verify.d.ts",
    "src/index.js",
    "cli.js",
    "README.md"
  ],
  "scripts": {
    "deploy:npm": "yarn npm publish",
    "test:browser": "webex-legacy-tools test --unit --runner karma",
    "test:style": "eslint ./*.js",
    "test:unit": "webex-legacy-tools test --unit --runner jest"
  }
}
