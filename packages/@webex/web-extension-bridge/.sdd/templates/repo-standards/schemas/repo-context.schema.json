{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/WebexTools/repo-standards/blob/main/schemas/repo-context.schema.json",
  "title": "Repository Operational Context Manifest",
  "description": "Schema for .repo-context.json manifests that encode source-of-truth, validation, ownership, fallback guidance, task playbooks, public interfaces, and change impact for agents.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "repository",
    "commands",
    "source_of_truth",
    "generated_artifacts",
    "validation_matrix",
    "surface_owners",
    "do_not_edit",
    "marker_scopes",
    "fallback_rules",
    "downstream_context_pack"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./schemas/repo-context.schema.json"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "task_playbooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "reference",
          "when_to_use",
          "start_with",
          "evidence_required",
          "allowed_edits",
          "validate_with",
          "fallback"
        ],
        "properties": {
          "task": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "when_to_use": {
            "type": "string",
            "minLength": 1
          },
          "start_with": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_required": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "allowed_edits": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "refresh_with": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validate_with": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fallback": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "public_interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "source",
          "entrypoints",
          "audience",
          "notes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "entrypoints": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source_of_truth": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "paths",
          "generated_artifacts",
          "refresh_with",
          "validate_with"
        ],
        "properties": {
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "generated_artifacts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "refresh_with": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validate_with": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "generated_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "generated_from", "refresh_with"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "generated_from": {
            "type": "string",
            "minLength": 1
          },
          "refresh_with": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paths", "minimum", "recommended"],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "minimum": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommended": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "change_impact": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paths", "affects", "validate_with", "avoid_direct_edits"],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "affects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "refresh_with": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validate_with": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "avoid_direct_edits": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "glossary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "definition"],
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_category", "sources", "requirement"],
        "properties": {
          "claim_category": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "negative_guidance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "why"],
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "confidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["high", "medium", "low"],
      "properties": {
        "high": {
          "$ref": "#/definitions/confidenceLevel"
        },
        "medium": {
          "$ref": "#/definitions/confidenceLevel"
        },
        "low": {
          "$ref": "#/definitions/confidenceLevel"
        }
      }
    },
    "repository_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_entrypoints",
        "workspace_packages",
        "source_surfaces",
        "generated_surfaces",
        "sync_paths",
        "validation_entrypoints"
      ],
      "properties": {
        "main_entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/topologyItem"
          }
        },
        "workspace_packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/topologyPathsItem"
          }
        },
        "source_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/topologyPathsItem"
          }
        },
        "generated_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "paths", "generated_from", "refresh_with"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "generated_from": {
                "type": "string",
                "minLength": 1
              },
              "refresh_with": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sync_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "targets", "mechanism"],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "targets": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mechanism": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "validation_entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "command", "scope"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "folder_readme_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_sections", "rules", "example_policy", "fallback"],
      "properties": {
        "required_sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "example_policy": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "regression_feedback_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trigger", "required_followups"],
        "properties": {
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "required_followups": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "surface_owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "owner", "edit_boundary"],
        "properties": {
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "edit_boundary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "do_not_edit": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "marker_scopes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fallback_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "downstream_context_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_human_surfaces",
        "required_agent_operational_surfaces",
        "required_machine_readable_surface"
      ],
      "properties": {
        "required_human_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_agent_operational_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_machine_readable_surface": {
          "type": "string",
          "minLength": 1
        },
        "recommended_machine_readable_sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "definitions": {
    "confidenceLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "expectation"],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "expectation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "topologyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "purpose"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "topologyPathsItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "paths", "notes"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
