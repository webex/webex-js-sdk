    "index_path": "docs/architecture.md",
    "definitions": {
      "http-core-sdk": {
        "kind": "sdk",
        "publication": "published",
        "source_kind": "repository-path",
        "source": "package.json",
        "summary": "Published npm package export surface declared by main/devMain/browser: the request and defaults clients, protoprepareFetchOptions and setTimingsAndFetch, the Interceptor extension contract subclasses implement, HttpStatusInterceptor, the HttpError taxonomy and its status-to-class select(), ProgressEvent, and detect. Per-export detail lives in the owning module spec Public surface."
      },
      "http-core-progress-events": {
        "kind": "event",
        "publication": "published",
        "source_kind": "repository-path",
        "source": "src/progress-event.js",
        "summary": "progress events emitted on the caller-visible options.download and options.upload emitters, carrying a ProgressEvent with loaded, total, and lengthComputable."
      },
      "http-core-xhr-fork": {
        "kind": "sdk",
        "publication": "internal",
        "source_kind": "repository-path",
        "source": "src/lib/xhr.js",
        "summary": "Vendored fork of naugtur/xhr held deliberately close to upstream so it keeps working in fully object-frozen environments."
      },
      "http-core-request-transport": {
        "kind": "sdk",
        "publication": "internal",
        "source_kind": "repository-path",
        "source": "src/request/index.js",
        "summary": "Internal transport interface used by the package entry point: applies request interceptors, dispatches to the platform transport or a caller-supplied options.request, then applies response interceptors in reverse order."
      },
      "webex-common-sdk": {
        "kind": "sdk",
        "publication": "published",
        "source_kind": "external",
        "source": "@webex/common (workspace package; Exception and isBuffer exports)",
        "summary": "Shared SDK primitives: the Exception base class HttpError extends, and the isBuffer predicate used for body and response detection."
      },
      "nodejs-request-library": {
        "kind": "sdk",
        "publication": "published",
        "source_kind": "external",
        "source": "request@^2.88.0 (npm)",
        "summary": "Third-party Node HTTP client used as the Node transport; option names are passed through largely unchanged, which is why the public option shape mirrors it."
      }
    }
