<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>Configuration</title>
    <link rel="stylesheet" type="text/css" href="/stylesheets/config.css" />
  </head>
  <body>
    <header>
      <h1>Configuration</h1>
    </header>
    <main>
      <p>Configure one organization and its Service App token.</p>
      {{#if errorMessage}}
        <p role="alert">{{errorMessage}}</p>
      {{/if}}
      <form action="/config" method="post">
        <div>
          <label for="clientId">Client ID:</label>
          <input type="text" id="clientId" name="clientId" required />
        </div>
        <div>
          <label for="clientSecret">Client Secret:</label>
          <input type="password" id="clientSecret" name="clientSecret" required />
        </div>
        <div>
          <label for="orgId">Organization ID:</label>
          <input type="text" id="orgId" name="orgId" autocomplete="off" spellcheck="false" required />
        </div>
        <div>
          <label for="refreshToken">Service App Refresh Token:</label>
          <input type="password" id="refreshToken" name="refreshToken" autocomplete="off" required />
        </div>
        <button type="submit">Authorize and open data sources</button>
      </form>
    </main>
    <footer>
      <p>&copy; 2024 Cisco</p>
    </footer>
  </body>
</html>
