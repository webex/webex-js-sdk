{
  "name": "@webex/webexconnect",
  "description": "Webex Connect JavaScript SDK",
  "license": "Cisco's General Terms (https://www.cisco.com/site/us/en/about/legal/contract-experience/index.html)",
  "private": true,
  "main": "dist/webex-connect-sdk.min.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/webex/webex-js-sdk.git",
    "directory": "packages/webexconnect"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "yarn build:src",
    "build:src": "webpack --config webpack.config.js && yarn sync:sample",
    "sync:sample": "node scripts/sync-sample.js",
    "clean": "rimraf dist",
    "test": "yarn test:style && yarn test:unit",
    "test:style": "eslint 'src/**/*.js'",
    "test:unit": "jest"
  },
  "devDependencies": {
    "eslint": "^8.24.0",
    "jest": "29.3.1",
    "jest-environment-jsdom": "29.3.1",
    "rimraf": "3.0.2",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.103.0",
    "webpack-cli": "^5.1.4"
  }
}
