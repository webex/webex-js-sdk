{
  "$schema": "./schemas/repo-context.schema.json",
  "version": 1,
  "repository": {
    "name": "<monorepo-name>",
    "purpose": "<one-sentence monorepo purpose>"
  },
  "commands": {
    "<root-command-id>": "<root-orchestration-command>"
  },
  "source_of_truth": [
    {
      "surface": "sdd-package-routing",
      "paths": [".sdd/manifest.json", "AGENTS.md", "docs/index.md"],
      "generated_artifacts": [".sdd/manifest.json"],
      "refresh_with": ["<root routing refresh command>"],
      "validate_with": ["<orchestrator root validation command>"]
    },
    {
      "surface": "<package-surface-name>",
      "paths": ["<package-path>/.sdd/manifest.json", "<package-path>/AGENTS.md"],
      "generated_artifacts": [],
      "refresh_with": ["<package refresh command>"],
      "validate_with": ["<package-validation-command>"]
    }
  ],
  "generated_artifacts": [
    {
      "path": ".sdd/templates/repo-standards/template-map.json",
      "generated_from": "<WebexTools/repo-standards@commit>",
      "refresh_with": "<template refresh command>"
    },
    {
      "path": ".sdd/templates/repo-annotation/override-map.json",
      "generated_from": "<repo-annotation-overrides@version>",
      "refresh_with": "<template refresh command>"
    }
  ],
  "validation_matrix": [
    {
      "paths": [".sdd/manifest.json", "AGENTS.md", "docs/index.md", ".repo-context.json"],
      "minimum": ["<orchestrator root validation command>"],
      "recommended": []
    },
    {
      "paths": ["<package-path>/**"],
      "minimum": ["<package-validation-command>"],
      "recommended": []
    }
  ],
  "repository_topology": {
    "main_entrypoints": [
      {
        "name": "<root-entrypoint-name>",
        "path": "<root-entrypoint-path>",
        "purpose": "<why-the-root-entrypoint-exists>"
      }
    ],
    "workspace_packages": [
      {
        "name": "<package-id>",
        "paths": ["<package-path>"],
        "notes": "<package routing note>"
      }
    ],
    "source_surfaces": [
      {
        "name": "<root-owned-surface>",
        "paths": ["<root-owned-path>"],
        "notes": "<why-this-root-surface-matters>"
      }
    ],
    "generated_surfaces": [
      {
        "name": "sdd-template-snapshot",
        "paths": [".sdd/templates/repo-standards"],
        "generated_from": "<WebexTools/repo-standards@commit>",
        "refresh_with": "<template refresh command>"
      },
      {
        "name": "sdd-root-overrides",
        "paths": [".sdd/templates/repo-annotation"],
        "generated_from": "<repo-annotation-overrides@version>",
        "refresh_with": "<template refresh command>"
      }
    ],
    "sync_paths": [
      {
        "source": "<WebexTools/repo-standards@commit>",
        "targets": [".sdd/templates/repo-standards"],
        "mechanism": "<template sync mechanism>"
      },
      {
        "source": "<repo-annotation-overrides@version>",
        "targets": [".sdd/templates/repo-annotation"],
        "mechanism": "<template sync mechanism>"
      }
    ],
    "validation_entrypoints": [
      {
        "name": "sdd-orchestrator-root",
        "command": "<orchestrator root validation command>",
        "scope": "Root routing manifest, root overrides, package routes, and routing blocks"
      }
    ]
  },
  "surface_owners": [
    {
      "surface": "sdd-package-routing",
      "owner": "<root-owner-or-team>",
      "edit_boundary": "Repo Annotation refreshes only the marker-delimited package routing blocks and the onboarded workspace_packages entries; all other root content is human-owned."
    },
    {
      "surface": "<package-surface-name>",
      "owner": "<package-owner-or-team>",
      "edit_boundary": "<package-editing-boundary>"
    }
  ],
  "do_not_edit": [".sdd/templates/repo-standards", ".sdd/templates/repo-annotation"],
  "marker_scopes": {
    "sdd-package-routing": ["AGENTS.md", "docs/index.md"]
  },
  "fallback_rules": [
    "Read the routed package's AGENTS.md and .sdd/manifest.json before changing package code.",
    "When a package is not listed in .sdd/manifest.json packages, treat its code as the only source of truth."
  ],
  "downstream_context_pack": {
    "required_human_surfaces": ["docs/index.md"],
    "required_agent_operational_surfaces": ["AGENTS.md"],
    "required_machine_readable_surface": ".repo-context.json",
    "recommended_machine_readable_sections": ["repository_topology"]
  }
}
